{
  "$id": "loom-console/v1/message.gap.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``gap`` (loom → console) : des événements perdus, avec un journal en mémoire saturé (décision D-4).\n\nAttributes:\n    tenant: Le client.\n    lost: Nombre d'événements perdus.\n    first_ts: Horodatage du premier perdu.\n    last_ts: Horodatage du dernier perdu.\n    reason: Pourquoi (``overflow``).",
  "properties": {
    "first_ts": {
      "format": "date-time",
      "title": "First Ts",
      "type": "string"
    },
    "last_ts": {
      "format": "date-time",
      "title": "Last Ts",
      "type": "string"
    },
    "lost": {
      "exclusiveMinimum": 0,
      "title": "Lost",
      "type": "integer"
    },
    "reason": {
      "const": "overflow",
      "default": "overflow",
      "title": "Reason",
      "type": "string"
    },
    "tenant": {
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "tenant",
    "lost",
    "first_ts",
    "last_ts"
  ],
  "title": "GapPayload",
  "type": "object"
}
