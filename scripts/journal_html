def main() -> int:
    ap = argparse.ArgumentParser(description="Journal Loom (.jsonl) -> page HTML lisible")
    ap.add_argument("journal", type=Path, help="fichier .jsonl d'une session")
    ap.add_argument(
        "-o", "--sortie", type=Path, help="fichier HTML à écrire (défaut : à côté du journal)"
    )
    args = ap.parse_args()
    if not args.journal.is_file():
        print(f"Fichier introuvable : {args.journal}", file=sys.stderr)
        return 2
    sortie: Path = args.sortie or args.journal.with_suffix(".html")
    evenements = lire_evenements(args.journal)
    sortie.write_text(construire(evenements, f"Journal Loom — {args.journal.stem}"), encoding="utf-8")
    print(f"Écrit : {sortie}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
