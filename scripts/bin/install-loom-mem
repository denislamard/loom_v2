#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# install-loom-mem — installe loom-mem-gpu en service systemd utilisateur.
#
# Livré avec loom-ia (installé dans le bin du venv, à côté de loom-mem-gpu) : le service
# lance le loom-mem-gpu de ce venv. Conception : docs/loom-mem-gpu.md (§8).
#
#   install-loom-mem [--port N] [--device D] [--offline] [--no-fp16]
#                    [--max-vram-fraction F] [--linger] [--dry-run]
#   install-loom-mem --uninstall [--dry-run]
#
# Rejouable sans risque : l'unité a un nom fixe (loom-mem-gpu.service), donc une seule
# instance. Unité identique : rien ne change, le service garde ses modèles. Unité
# différente : la différence est montrée, l'unité réécrite, le service redémarré. Un port
# déjà pris par autre chose que ce service (instance lancée à la main, autre programme)
# arrête le script avant toute écriture ; il ne tue jamais un process qu'il n'a pas lancé.
#
# Codes de sortie : 0 fait (ou rien à faire), 1 échec du démarrage, 2 options ou
# prérequis refusés, 3 port déjà pris.
#
# LOOM_MEM_READY_WAIT : attente maximale du chargement des modèles, en secondes (180).

set -euo pipefail

readonly UNIT_NAME="loom-mem-gpu.service"
readonly DEFAULT_PORT=8765
readonly READY_WAIT="${LOOM_MEM_READY_WAIT:-180}" # secondes ; les modèles se chargent
readonly PROG="install-loom-mem"

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly BIN_DIR
readonly APP="$BIN_DIR/loom-mem-gpu"
readonly UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
readonly UNIT_FILE="$UNIT_DIR/$UNIT_NAME"

port=""
device="cuda"
offline=0
no_fp16=0
vram_fraction=""
linger=0
dry_run=0
uninstall=0

say() { printf '%s : %s\n' "$PROG" "$*"; }
fail() {
    local code="$1"
    shift
    printf '%s : %s\n' "$PROG" "$*" >&2
    exit "$code"
}

usage() {
    sed -n '4,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

value_of() { # l'option $1 attend une valeur : $2
    [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || fail 2 "$1 attend une valeur"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --port) value_of "$@"; port="$2"; shift 2 ;;
        --device) value_of "$@"; device="$2"; shift 2 ;;
        --offline) offline=1; shift ;;
        --no-fp16) no_fp16=1; shift ;;
        --max-vram-fraction) value_of "$@"; vram_fraction="$2"; shift 2 ;;
        --linger) linger=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        --uninstall) uninstall=1; shift ;;
        -h | --help) usage; exit 0 ;;
        *) fail 2 "option inconnue : $1 (voir --help)" ;;
    esac
done

run() { # une commande qui change quelque chose : affichée, pas lancée, avec --dry-run
    if ((dry_run)); then
        printf '  [dry-run] %s\n' "$*"
    else
        "$@"
    fi
}

# --- Prérequis ----------------------------------------------------------------------

command -v systemctl >/dev/null 2>&1 || fail 2 "systemctl introuvable : systemd est requis"
systemctl --user show-environment >/dev/null 2>&1 \
    || fail 2 "systemctl --user ne répond pas : pas de session systemd utilisateur"

# --- Désinstallation ----------------------------------------------------------------

if ((uninstall)); then
    if [[ ! -f "$UNIT_FILE" ]]; then
        say "rien à désinstaller ($UNIT_FILE absent)"
        exit 0
    fi
    run systemctl --user disable --now "$UNIT_NAME"
    run rm -f "$UNIT_FILE"
    run systemctl --user daemon-reload
    say "désinstallé : service arrêté, $UNIT_FILE retiré"
    exit 0
fi

# --- Installation ---------------------------------------------------------------------

[[ -x "$APP" ]] || fail 2 "loom-mem-gpu introuvable à côté de ce script ($APP) : réinstaller loom-ia"
port="${port:-$DEFAULT_PORT}"
[[ "$port" =~ ^[0-9]+$ ]] || fail 2 "--port : un nombre est attendu ($port)"

options=(--device "$device")
[[ "$port" == "$DEFAULT_PORT" ]] || options+=(--port "$port")
((offline)) && options+=(--offline)
((no_fp16)) && options+=(--no-fp16)
[[ -z "$vram_fraction" ]] || options+=(--max-vram-fraction "$vram_fraction")

# Les réglages et les dépendances, validés par l'application elle-même : aucune règle
# recopiée ici.
"$APP" serve "${options[@]}" --check >/dev/null || fail 2 "réglages refusés (voir ci-dessus)"

if [[ "$device" == cuda* ]]; then
    if ! { command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; }; then
        fail 2 "--device $device : nvidia-smi ne voit aucune carte (pilote NVIDIA ?)"
    fi
fi

quoted_app="\"$APP\""
exec_start="$quoted_app serve ${options[*]}"
environment=("PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True")
# Le cache des modèles : celui du shell, si on l'a déplacé (le service ne lit pas ~/.bashrc).
[[ -z "${HF_HOME:-}" ]] || environment+=("HF_HOME=$HF_HOME")

unit() {
    cat <<EOF
# Écrit par install-loom-mem : le relancer plutôt que modifier ce fichier à la main.
[Unit]
Description=loom-mem-gpu — modèles de la mémoire de loom gardés en VRAM
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStart=$exec_start
EOF
    local item
    for item in "${environment[@]}"; do
        printf 'Environment=%s\n' "$item"
    done
    cat <<EOF
Restart=on-failure
RestartSec=5
# Réglages refusés (2) ou port pris (3) : relancer ne changerait rien.
RestartPreventExitStatus=2 3

[Install]
WantedBy=default.target
EOF
}

wanted="$(unit)"
current=""
[[ -f "$UNIT_FILE" ]] && current="$(cat "$UNIT_FILE")"
active=0
systemctl --user is-active --quiet "$UNIT_NAME" && active=1

# Le port que ce service occupe aujourd'hui, s'il tourne.
current_port="$DEFAULT_PORT"
if [[ "$current" =~ --port[[:space:]]+([0-9]+) ]]; then
    current_port="${BASH_REMATCH[1]}"
fi

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

# Un port pris par autre chose que ce service : on s'arrête avant toute écriture.
if port_open "$port" && ! ((active && current_port == port)); then
    fail 3 "le port $port est déjà pris, et pas par ce service (une instance lancée à la main ? un autre programme ?) : la fermer, ou choisir --port"
fi

changed=1
[[ "$current" == "$wanted" ]] && changed=0

if ((changed == 0 && active)); then
    say "déjà installé et actif, unité à jour : rien à faire"
    systemctl --user is-enabled --quiet "$UNIT_NAME" || run systemctl --user enable "$UNIT_NAME"
    "$APP" status --url "http://127.0.0.1:$port" || true
    exit 0
fi

if ((changed)); then
    if [[ -n "$current" ]]; then
        say "l'unité change :"
        diff -u <(printf '%s\n' "$current") <(printf '%s\n' "$wanted") \
            --label "$UNIT_FILE (actuelle)" --label "$UNIT_FILE (nouvelle)" || true
    elif ((dry_run)); then
        say "unité à écrire dans $UNIT_FILE :"
        printf '%s\n' "$wanted"
    fi
    run mkdir -p "$UNIT_DIR"
    if ((dry_run)); then
        printf '  [dry-run] écrire %s\n' "$UNIT_FILE"
    else
        printf '%s\n' "$wanted" >"$UNIT_FILE.tmp"
        mv -f "$UNIT_FILE.tmp" "$UNIT_FILE"
    fi
    run systemctl --user daemon-reload
fi

run systemctl --user enable "$UNIT_NAME"
# restart démarre un service arrêté, et arrête l'ancien process avant d'en lancer un.
run systemctl --user restart "$UNIT_NAME"

if ((linger)); then
    run loginctl enable-linger "$USER"
elif command -v loginctl >/dev/null 2>&1 \
    && [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)" != "yes" ]]; then
    say "le service s'arrête avec la session ; pour qu'il tourne sans session : --linger"
fi

if ((dry_run)); then
    say "dry-run : rien n'a été modifié"
    exit 0
fi

say "service démarré, chargement des modèles (au plus ${READY_WAIT} s)…"
deadline=$((SECONDS + READY_WAIT))
while ((SECONDS < deadline)); do
    if "$APP" status --url "http://127.0.0.1:$port" >/dev/null 2>&1; then
        "$APP" status --url "http://127.0.0.1:$port"
        say "prêt"
        exit 0
    fi
    if systemctl --user is-failed --quiet "$UNIT_NAME"; then
        break
    fi
    sleep 2
done

say "le service n'est pas prêt ; la fin de son journal :" >&2
journalctl --user -u "$UNIT_NAME" -n 30 --no-pager >&2 || true
exit 1
